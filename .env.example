# Database
DATABASE_URL=postgresql+asyncpg://betterway:9a301301@localhost:5432/you_time

# Redis
REDIS_URL=redis://localhost:6379/0

# 阿里云百炼平台 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key

# 基础模型配置
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-plus
IMAGE_MODEL=wanx-v1
TTS_MODEL=sambert-zhichu-v1

# LLM任务特定模型（可选，覆盖基础配置）
LLM_SCRIPT_MODEL=           # 文案生成（默认使用LLM_MODEL）
LLM_POLISH_MODEL=            # 提示词润色
LLM_ANALYSIS_MODEL=          # 内容分析
LLM_SUMMARY_MODEL=           # 摘要生成

# 文件存储路径
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
